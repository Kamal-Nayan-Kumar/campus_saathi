# --- Telegram Bot Tokens ---
# Get these from @BotFather
TELEGRAM_STUDENT_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=

# --- Webhook Config (REQUIRED for Render) ---
WEBHOOK_URL=

# --- LLM (Groq) ---
# Groq hosts openai/gpt-oss-120b behind its OpenAI-compatible API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Vector DB (Qdrant Cloud) ---
# Create a free cluster at https://cloud.qdrant.io
# Prerequisite: enable server-side embeddings for
# sentence-transformers/all-MiniLM-L6-v2 (must show "Cost: Free"
# in the cluster's Inference tab).
QDRANT_URL=
QDRANT_API_KEY=

# --- PDF Parsing (Firecrawl) ---
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Server Config ---
HOST=0.0.0.0
PORT=8000
