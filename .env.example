# --- Telegram Bot Tokens ---
# Get these from @BotFather
TELEGRAM_STUDENT_BOT_TOKEN=your_student_bot_token_here
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here

# --- Webhook Config (REQUIRED for Render) ---
# Your Render Service URL (e.g., https://campus-saathi.onrender.com)
# Do not add trailing slash
WEBHOOK_URL=https://your-app-name.onrender.com

# --- AI Models (Rotation System) ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=...
GITHUB_TOKEN=...
PERPLEXITY_API_KEY=pplx-...

# --- DataStax Astra DB ---
ASTRA_DB_API_ENDPOINT=https://<your_db_id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here

# --- Security & Auth ---
ADMIN_EMAILS=admin1@example.com,admin2@college.edu

# --- Firebase Configuration ---
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
FIREBASE_WEB_API_KEY=your_web_api_key_here

# --- Server Config ---
HOST=0.0.0.0
PORT=8000
