# --- Telegram Bot Tokens ---
# Get these from @BotFather
TELEGRAM_STUDENT_BOT_TOKEN=your_student_bot_token_here
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here

# --- Google Gemini ---
# Get from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# --- DataStax Astra DB ---
# Get from Astra DB Dashboard -> Connect
ASTRA_DB_API_ENDPOINT=https://<your_db_id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here

# --- Security & Auth ---
# The email address authorized to perform admin actions (2-step verification)
ADMIN_EMAIL=your_personal_email@example.com

# --- Email Configuration (For Sending OTPs) ---
# Required for sending the 6-digit verification code
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email_for_sending_otps@gmail.com
SENDER_PASSWORD=your_app_specific_password

# --- Firebase Configuration ---
# You can provide the path to your service account JSON file
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# OR provide the JSON content directly (useful for Render Env Vars)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# --- Server Config ---
HOST=0.0.0.0
PORT=8000