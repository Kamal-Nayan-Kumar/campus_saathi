# --- Telegram Bot Tokens ---
# Get these from @BotFather
TELEGRAM_STUDENT_BOT_TOKEN=your_student_bot_token_here
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here

# --- AI Models (Rotation System) ---
# 1. Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# 2. Groq
GROQ_API_KEY=gsk_...
# 3. Cerebras
CEREBRAS_API_KEY=...
# 4. GitHub Models
GITHUB_TOKEN=...
# 5. Perplexity (Backup)
PERPLEXITY_API_KEY=pplx-...

# --- DataStax Astra DB ---
# Get from Astra DB Dashboard -> Connect
ASTRA_DB_API_ENDPOINT=https://<your_db_id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here

# --- Security & Auth ---
# Comma-separated list of emails authorized to perform admin actions
ADMIN_EMAILS=admin1@example.com,admin2@college.edu

# --- Firebase Configuration ---
# You can provide the path to your service account JSON file
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# OR provide the JSON content directly (useful for Render Env Vars)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# Web API Key from Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_WEB_API_KEY=your_web_api_key_here

# --- Server Config ---
HOST=0.0.0.0
PORT=8000